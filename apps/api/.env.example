# Copy to .env — see root README "Meta Pixel + Conversions API"

# Meta Conversions API (optional — same Pixel ID as VITE_META_PIXEL_ID on the web app)
# META_PIXEL_ID=123456789012345
# META_CONVERSIONS_API_ACCESS_TOKEN=
# META_TEST_EVENT_CODE=

# Web app origin (used in CAPI event_source_url fallbacks)
# WEB_URL=http://localhost:5173

# ── Google Analytics 4 — Data API (admin dashboard Traffic tab) ──────────────
# GA4_PROPERTY_ID       Numeric property ID from GA4 Admin → Property Settings.
#                       E.g. 123456789  (no "properties/" prefix)
# GA4_SERVICE_ACCOUNT_JSON  Full service-account key JSON as a single-line string.
#                       Grant the service account "Viewer" on the GA4 property.
#                       Paste the entire JSON value here (escape inner quotes if needed).
# GA4_PROPERTY_ID=
# GA4_SERVICE_ACCOUNT_JSON=
